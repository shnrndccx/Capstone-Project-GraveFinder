# Cross-platform line ending configuration
# Ensures consistent line endings (LF) across Windows, macOS, and Linux
* text=auto

# Text files - use Unix line endings (LF)
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Video/Media files
assets/gommp.mp4 filter=lfs diff=lfs merge=lfs -text
